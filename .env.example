# Required absolute directory containing all reviewable repositories.
REVIEW_BASE_DIR=/absolute/path/to/repositories

# Read-only Git execution bounds.
REVIEW_MAX_COMMAND_TIMEOUT_MS=30000
REVIEW_MAX_BUFFER_SIZE_MB=10

MCP_TRANSPORT_TYPE=stdio
MCP_SESSION_MODE=auto
MCP_LOG_LEVEL=info
MCP_RESPONSE_FORMAT=json
MCP_RESPONSE_VERBOSITY=standard

# HTTP transport options (used only with MCP_TRANSPORT_TYPE=http).
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3015
MCP_HTTP_ENDPOINT_PATH=/mcp
MCP_ALLOWED_ORIGINS=http://localhost:8080

# Optional authentication.
MCP_AUTH_MODE=none
# MCP_AUTH_SECRET_KEY=replace-with-at-least-32-characters
# OAUTH_ISSUER_URL=https://issuer.example.com
# OAUTH_AUDIENCE=repo-review-mcp

# Optional telemetry.
OTEL_ENABLED=false
