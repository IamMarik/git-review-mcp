{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.iammarik/repo-review-mcp",
  "description": "A read-only MCP server designed specifically for AI code review workflows.",
  "repository": {
    "url": "https://github.com/IamMarik/git-review-mcp",
    "source": "github"
  },
  "version": "0.1.0",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@iammarik/repo-review-mcp",
      "version": "0.1.0",
      "runtimeHint": "bun",
      "packageArguments": [
        { "type": "positional", "value": "run" },
        { "type": "positional", "value": "start:stdio" }
      ],
      "environmentVariables": [
        {
          "name": "REVIEW_BASE_DIR",
          "description": "Required absolute directory containing every reviewable local repository.",
          "format": "string",
          "isRequired": true
        },
        {
          "name": "MCP_LOG_LEVEL",
          "description": "Minimum structured log level.",
          "format": "string",
          "isRequired": false,
          "default": "info"
        }
      ],
      "transport": { "type": "stdio" }
    }
  ],
  "mcpName": "io.github.iammarik/repo-review-mcp"
}
